# =============================================================================
# Telegram To-Do Bot — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Required ---
# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Database ---
# SQLite (local dev):
DATABASE_URL=sqlite:///./todo_bot.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Bot mode ---
# Use "polling" for local development.
# Use "webhook" for production (requires WEBHOOK_URL).
BOT_MODE=polling

# --- Webhook (only needed when BOT_MODE=webhook) ---
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443
# Secret token to validate incoming webhook updates (optional but recommended)
WEBHOOK_SECRET_TOKEN=

# --- Timezone ---
# Default timezone applied to all new users.
# Users can override via /settings later.
TIMEZONE=Asia/Kolkata

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
